generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  name              String?
  phone             String?
  rut               String?   @unique
  role              String    @default("investor")
  kycStatus         String    @default("pending")
  kycSubmittedAt    DateTime?
  kycVerifiedAt     DateTime?
  avatarUrl         String?
  stripeCustomerId  String?
  balance           Float     @default(0)
  totalInvested     Float     @default(0)
  totalEarnings     Float     @default(0)

  // New CMS fields
  preferredLanguage String    @default("es")
  newsletterOptIn  Boolean   @default(false)
  termsAcceptedAt  DateTime?
  termsVersion     String?
  riskProfile      String?
  referralCode     String?   @unique
  referredBy       String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  notes            String?

  investments       Investment[]
  transactions      Transaction[]
  dividendPayments  DividendPayment[]
  kycDocuments      KYCDocument[]
  notifications     Notification[]
  liquidityRequests LiquidityRequest[]
  blogPosts         BlogPost[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model KYCDocument {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType  String
  documentUrl   String
  status        String    @default("pending")
  reviewedAt    DateTime?
  reviewedBy    String?
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==================== ASSETS ====================

model Asset {
  id                    String              @id @default(cuid())
  name                  String
  slug                  String              @unique
  type                  String
  status                String              @default("draft")

  address               String
  city                  String
  region                String
  country               String              @default("Chile")
  latitude              Float?
  longitude             Float?

  totalValue            Float
  pricePerFraction      Float
  totalFractions        Int
  availableFractions    Int
  minimumInvestment     Float
  fundedPercentage      Float               @default(0)

  annualYield           Float
  projectedAppreciation Float
  totalProjectedReturn  Float

  leaseStatus           String              @default("vacant")
  leaseStart            DateTime?
  leaseEnd              DateTime?
  monthlyRent           Float?
  tenantName            String?

  totalArea             Float?
  units                 Int?
  constructionYear      Int?
  landUse               String?

  shortDescription      String
  fullDescription       String
  highlights            String

  badge                 String?

  operationalCosts      Float?
  operationalCostsPct   Float?

  // New CMS fields
  riskLevel             String              @default("medium")
  riskDescription       String?
  videoUrl              String?
  virtualTourUrl        String?
  minInvestmentPeriod   Int?
  dividendFrequency     String              @default("monthly")
  featuredOrder         Int?
  seoTitle              String?
  seoDescription        String?
  publishedAt           DateTime?
  tags                  String?
  amenities             String?

  images                AssetImage[]
  documents             AssetDocument[]
  cashFlowProjections   CashFlowProjection[]
  investments           Investment[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model AssetImage {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)

  createdAt DateTime @default(now())
}

model AssetDocument {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title        String
  documentType String
  fileUrl      String
  fileSize     Int?

  createdAt    DateTime @default(now())
}

model CashFlowProjection {
  id                String   @id @default(cuid())
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period            String
  periodType        String   @default("yearly")
  grossIncome       Float
  operationalCost   Float
  netIncome         Float
  appreciation      Float?
  totalReturn       Float?
  cumulativeReturn  Float?

  createdAt         DateTime @default(now())
}

// ==================== INVESTMENTS & TRANSACTIONS ====================

model Investment {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  assetId          String
  asset            Asset          @relation(fields: [assetId], references: [id])

  quantity         Int            @default(1)
  pricePerUnit     Float
  totalAmount      Float
  status           String         @default("pending")

  stripePaymentId  String?
  completedAt      DateTime?

  transactions     Transaction[]
  dividendPayments DividendPayment[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Transaction {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  investmentId       String?
  investment         Investment?  @relation(fields: [investmentId], references: [id])

  type               String
  amount             Float
  currency           String       @default("CLP")
  status             String       @default("pending")

  bookValue          Float?
  salePrice          Float?
  description        String?
  metadata           String?

  // New CMS fields
  referenceId        String?
  feeAmount          Float?
  netAmount          Float?
  receiptUrl         String?
  processedBy        String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// ==================== DIVIDENDS ====================

model DividendPayment {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  investmentId    String
  investment      Investment  @relation(fields: [investmentId], references: [id])
  assetId         String
  amount          Float
  perFraction     Float
  fractions       Int
  periodStart     DateTime
  periodEnd       DateTime
  paymentDate     DateTime?
  status          String      @default("pending")

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ==================== LIQUIDITY ENGINE ====================

model LiquidityPool {
  id                 String              @id @default(cuid())
  totalReserve       Float               @default(0)
  totalAssets        Int                 @default(0)
  activeRequests     Int                 @default(0)
  utilizationRate    Float               @default(0)
  monthlyContribution Float?
  autoReplenish      Boolean             @default(true)

  requests           LiquidityRequest[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model LiquidityRequest {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  poolId               String
  pool                 LiquidityPool  @relation(fields: [poolId], references: [id])
  investmentId         String

  fractionCount        Int
  bookValuePerFraction Float
  totalAmount          Float
  status               String         @default("pending")

  expressFee           Float          @default(0)
  netAmount            Float?
  processingDays       Int            @default(3)

  approvedAt           DateTime?
  completedAt          DateTime?
  rejectedReason       String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  String?

  createdAt DateTime @default(now())
}

// ==================== CMS: SITE SETTINGS ====================

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  type        String   @default("text")
  group       String   @default("general")
  label       String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: BLOG ====================

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  coverImage    String?
  category      String    @default("educacion")
  tags          String    @default("")
  authorId      String?
  author        User?     @relation(fields: [authorId], references: [id])
  status        String    @default("draft")
  publishedAt   DateTime?
  featured      Boolean   @default(false)
  readingTime   Int?
  views         Int       @default(0)
  seoTitle      String?
  seoDescription String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==================== CMS: FAQ ====================

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("inversion")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: TESTIMONIALS ====================

model Testimonial {
  id                String   @id @default(cuid())
  name              String
  role              String?
  avatarUrl         String?
  quote             String
  rating            Int      @default(5)
  investmentAmount  Float?
  assetName         String?
  isFeatured        Boolean  @default(false)
  isVerified        Boolean  @default(true)
  sortOrder         Int      @default(0)
  status            String   @default("pending")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==================== CMS: LEGAL DOCUMENTS ====================

model LegalDocument {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String
  version       String   @default("1.0")
  effectiveDate DateTime
  type          String   @default("terms")
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== CMS: TEAM MEMBERS ====================

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String   @default("")
  photoUrl    String?
  linkedinUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: EMAIL TEMPLATES ====================

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  bodyHtml    String
  bodyText    String   @default("")
  variables   String   @default("[]")
  category    String   @default("transactional")
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: PROMOTIONS ====================

model Promotion {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  type          String   @default("bonus_yield")
  value         Float    @default(0)
  minInvestment Float?
  validFrom     DateTime
  validTo       DateTime?
  maxUses       Int?
  usedCount     Int      @default(0)
  assetTypes    String?
  description   String?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== CMS: EMAIL LOG ====================

model EmailLog {
  id           String   @id @default(cuid())
  to           String
  subject      String
  bodyHtml     String
  bodyText     String
  templateName String?
  variables    String?
  status       String   @default("sent")
  sentAt       DateTime @default(now())

  createdAt    DateTime @default(now())
}

// ==================== CMS: AUDIT LOG ====================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @default("system")
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?

  createdAt DateTime @default(now())
}

// ==================== CMS: ASSET TYPES ====================

model AssetType {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  color       String?  @default("#059669")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: TRANSLATIONS ====================

model Translation {
  id          String   @id @default(cuid())
  key         String
  locale      String   @default("es")
  value       String   @default("")

  @@unique([key, locale])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: CURRENCIES ====================

model Currency {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  symbol      String   @default("")
  flag        String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
