generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  name              String?
  phone             String?
  rut               String?   @unique
  role              String    @default("investor")
  kycStatus         String    @default("pending")
  kycSubmittedAt    DateTime?
  kycVerifiedAt     DateTime?
  avatarUrl         String?
  stripeCustomerId  String?
  balance           Float     @default(0)
  totalInvested     Float     @default(0)
  totalEarnings     Float     @default(0)

  // New CMS fields
  preferredLanguage String    @default("es")
  newsletterOptIn  Boolean   @default(false)
  termsAcceptedAt  DateTime?
  termsVersion     String?
  riskProfile      String?
  // Referral relations
  referralCode     ReferralCode?
  referrals        Referral[]  @relation("ReferrerReferrals")
  referredBy       Referral[]  @relation("ReferredReferrals")
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  notes            String?

  // ERC-6551 / wallet integration (fase 1)
  walletAddress       String?
  walletNonce         String?
  walletNonceExpiresAt DateTime?
  walletLinkedAt      DateTime?

  investments       Investment[]
  secondaryMarketListings    SecondaryMarketListing[] @relation("SellerListings")
  secondaryMarketPurchases   SecondaryMarketListing[] @relation("BuyerPurchases")
  transactions      Transaction[]
  dividendPayments  DividendPayment[]
  kycDocuments      KYCDocument[]
  notifications     Notification[]
  liquidityRequests LiquidityRequest[]
  blogPosts         BlogPost[]
  fundInvestments   FundInvestment[]
  fundDividendPayments FundDividendPayment[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ==================== FUNDS ENGINE ====================

model Fund {
  id                        String    @id
  name                      String
  slug                      String    @unique
  description               String
  status                    String    @default("active") // active, paused, closed
  initialNavPerShare        Float     @default(0)
  navPerShare               Float     @default(0)
  totalShares               Int       @default(0)
  availableShares           Int       @default(0)
  pricePerShare             Float     @default(0)
  totalAUM                  Float     @default(0)
  expenseRatio              Float     @default(0)
  dividendYield             Float     @default(0)
  totalReturn1Y             Float     @default(0)
  totalReturnSinceInception Float     @default(0)
  fundType                  String    @default("mixed") // reit, mixed, datacenter, income
  riskLevel                 String    @default("medium")
  rebalanceFrequency        String    @default("quarterly")
  minInvestment             Float     @default(0)
  maxInvestmentPerUser      Float?
  inceptionDate             DateTime
  dividendFrequency         String    @default("quarterly") // monthly, quarterly
  fundManager               String?
  badge                     String?
  highlights                String?

  holdings                 FundHolding[]
  navHistory               NAVHistory[]
  fundInvestments          FundInvestment[]
  dividends                FundDividendPayment[]
  rebalanceLogs            RebalanceLog[]

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status])
  @@index([fundType])
}

model FundHolding {
  id               String   @id @default(cuid())
  fundId           String
  fund             Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset    @relation(fields: [assetId], references: [id])

  targetWeightPct  Float    @default(0)
  currentWeightPct Float    @default(0)
  fractionCount    Int      @default(0)
  valueUsd         Float    @default(0)
  averageBuyPrice  Float    @default(0)
  totalCostBasis   Float    @default(0)
  unrealizedPL     Float    @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([fundId, assetId])
  @@index([assetId])
}

model FundInvestment {
  id              String   @id @default(cuid())
  fundId          String
  fund            Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  shares          Float    @default(0)
  averageBuyPrice Float    @default(0)
  totalInvested   Float    @default(0)
  currentValue    Float    @default(0)
  unrealizedPL    Float    @default(0)
  status          String   @default("active")

  dividends       FundDividendPayment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, fundId])
  @@index([status])
}

model FundDividendPayment {
  id                 String   @id @default(cuid())
  fundId             String
  fund               Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  fundInvestmentId   String
  fundInvestment     FundInvestment @relation(fields: [fundInvestmentId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id])

  sharesHeld         Float    @default(0)
  dividendPerShare   Float    @default(0)
  totalAmount        Float    @default(0)
  periodStart        DateTime
  periodEnd          DateTime
  paymentDate        DateTime?
  status             String   @default("pending")

  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([fundInvestmentId])
  @@index([fundId, periodStart])
  @@unique([fundId, fundInvestmentId, periodStart])
}

model NAVHistory {
  id          String   @id @default(cuid())
  fundId      String
  fund        Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  navPerShare Float
  totalAUM    Float    @default(0)
  totalShares Int      @default(0)
  date        DateTime

  createdAt   DateTime @default(now())

  @@unique([fundId, date])
  @@index([date])
}

model RebalanceLog {
  id              String   @id @default(cuid())
  fundId          String
  fund            Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)

  reason          String
  previousWeights String
  newWeights      String
  executedBy      String   @default("system")

  createdAt       DateTime @default(now())

  @@index([fundId])
}

model KYCDocument {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType  String
  documentUrl   String
  status        String    @default("pending")
  reviewedAt    DateTime?
  reviewedBy    String?
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==================== ASSETS ====================

model Asset {
  id                    String              @id @default(cuid())
  name                  String
  slug                  String              @unique
  type                  String
  status                String              @default("draft")

  address               String
  city                  String
  region                String
  country               String              @default("Chile")
  latitude              Float?
  longitude             Float?

  totalValue            Float
  pricePerFraction      Float
  totalFractions        Int
  availableFractions    Int
  minimumInvestment     Float
  fundedPercentage      Float               @default(0)

  annualYield           Float
  projectedAppreciation Float
  totalProjectedReturn  Float

  leaseStatus           String              @default("vacant")
  leaseStart            DateTime?
  leaseEnd              DateTime?
  monthlyRent           Float?
  tenantName            String?

  totalArea             Float?
  units                 Int?
  constructionYear      Int?
  landUse               String?

  shortDescription      String
  fullDescription       String
  highlights            String

  badge                 String?

  operationalCosts      Float?
  operationalCostsPct   Float?

  // New CMS fields
  riskLevel             String              @default("medium")
  riskDescription       String?
  videoUrl              String?
  virtualTourUrl        String?
  minInvestmentPeriod   Int?
  dividendFrequency     String              @default("monthly")
  featuredOrder         Int?
  seoTitle              String?
  seoDescription        String?
  publishedAt           DateTime?
  tags                  String?
  amenities             String?

  images                AssetImage[]
  documents             AssetDocument[]
  cashFlowProjections   CashFlowProjection[]
  investments           Investment[]
  secondaryMarketListings SecondaryMarketListing[]
  fundHoldings          FundHolding[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([type])
  @@index([status])
}

model AssetImage {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([assetId])
}

model AssetDocument {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title        String
  documentType String
  fileUrl      String
  fileSize     Int?

  createdAt    DateTime @default(now())

  @@index([assetId])
}

model CashFlowProjection {
  id                String   @id @default(cuid())
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period            String
  periodType        String   @default("yearly")
  grossIncome       Float
  operationalCost   Float
  netIncome         Float
  appreciation      Float?
  totalReturn       Float?
  cumulativeReturn  Float?

  createdAt         DateTime @default(now())

  @@index([assetId])
}

// ==================== INVESTMENTS & TRANSACTIONS ====================

model Investment {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  assetId          String
  asset            Asset          @relation(fields: [assetId], references: [id])

  quantity         Int            @default(1)
  pricePerUnit     Float
  totalAmount      Float
  status           String         @default("pending")

  stripePaymentId  String?
  completedAt      DateTime?

  // ERC-6551 / on-chain position (fase 1)
  tokenId        Int?
  tokenContract  String?
  tbaAddress     String?
  chainId        Int?

  transactions     Transaction[]
  dividendPayments DividendPayment[]
  secondaryMarketListings SecondaryMarketListing[]
  onChainActions   OnChainAction[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([assetId])
  @@index([status])
  @@index([stripePaymentId])
}

// Receipts/acciones on-chain (minteos, TBA, transferencias) — idempotencia ERC-6551
model OnChainAction {
  id             String     @id @default(cuid())
  investmentId   String?
  investment     Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  listingId      String?
  action         String
  status         String     @default("pending") // pending, submitted, mined, failed, dry-run
  chainId        Int?
  txHash         String?
  tokenId        Int?
  tokenContract  String?
  tbaAddress     String?
  payload        String?
  error          String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([investmentId])
  @@index([status])
  @@index([txHash])
}

model Transaction {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  investmentId       String?
  investment         Investment?  @relation(fields: [investmentId], references: [id])

  type               String
  amount             Float
  currency           String       @default("CLP")
  status             String       @default("pending")

  bookValue          Float?
  salePrice          Float?
  description        String?
  metadata           String?

  // New CMS fields
  referenceId        String?
  feeAmount          Float?
  netAmount          Float?
  receiptUrl         String?
  processedBy        String?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId])
  @@index([investmentId])
  @@index([referenceId])
  @@index([status])
}

// ==================== DIVIDENDS ====================

model DividendPayment {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  investmentId    String
  investment      Investment  @relation(fields: [investmentId], references: [id])
  assetId         String
  amount          Float
  perFraction     Float
  fractions       Int
  periodStart     DateTime
  periodEnd       DateTime
  paymentDate     DateTime?
  status          String      @default("pending")

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([investmentId])
  @@index([assetId])
}

// ==================== LIQUIDITY ENGINE ====================

model LiquidityPool {
  id                 String              @id @default(cuid())
  totalReserve       Float               @default(0)
  totalAssets        Int                 @default(0)
  activeRequests     Int                 @default(0)
  utilizationRate    Float               @default(0)
  monthlyContribution Float?
  autoReplenish      Boolean             @default(true)

  requests           LiquidityRequest[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model LiquidityRequest {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  poolId               String
  pool                 LiquidityPool  @relation(fields: [poolId], references: [id])
  investmentId         String

  fractionCount        Int
  bookValuePerFraction Float
  totalAmount          Float
  status               String         @default("pending")

  expressFee           Float          @default(0)
  netAmount            Float?
  processingDays       Int            @default(3)

  approvedAt           DateTime?
  completedAt          DateTime?
  rejectedReason       String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([poolId])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}

// ==================== CMS: SITE SETTINGS ====================

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @default("")
  type        String   @default("text")
  group       String   @default("general")
  label       String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: BLOG ====================

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  coverImage    String?
  category      String    @default("educacion")
  tags          String    @default("")
  authorId      String?
  author        User?     @relation(fields: [authorId], references: [id])
  status        String    @default("draft")
  publishedAt   DateTime?
  featured      Boolean   @default(false)
  readingTime   Int?
  views         Int       @default(0)
  seoTitle      String?
  seoDescription String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([authorId])
}

// ==================== CMS: FAQ ====================

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("inversion")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: TESTIMONIALS ====================

model Testimonial {
  id                String   @id @default(cuid())
  name              String
  role              String?
  avatarUrl         String?
  quote             String
  rating            Int      @default(5)
  investmentAmount  Float?
  assetName         String?
  isFeatured        Boolean  @default(false)
  isVerified        Boolean  @default(true)
  sortOrder         Int      @default(0)
  status            String   @default("pending")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==================== CMS: LEGAL DOCUMENTS ====================

model LegalDocument {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String
  version       String   @default("1.0")
  effectiveDate DateTime
  type          String   @default("terms")
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== CMS: TEAM MEMBERS ====================

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  bio         String   @default("")
  photoUrl    String?
  linkedinUrl String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: EMAIL TEMPLATES ====================

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  bodyHtml    String
  bodyText    String   @default("")
  variables   String   @default("[]")
  category    String   @default("transactional")
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: PROMOTIONS ====================

model Promotion {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  type          String   @default("bonus_yield")
  value         Float    @default(0)
  minInvestment Float?
  validFrom     DateTime
  validTo       DateTime?
  maxUses       Int?
  usedCount     Int      @default(0)
  assetTypes    String?
  description   String?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== CMS: EMAIL LOG ====================

model EmailLog {
  id           String   @id @default(cuid())
  to           String
  subject      String
  bodyHtml     String
  bodyText     String
  templateName String?
  variables    String?
  status       String   @default("sent")
  sentAt       DateTime @default(now())

  createdAt    DateTime @default(now())
}

// ==================== CMS: AUDIT LOG ====================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @default("system")
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?

  createdAt DateTime @default(now())
}

// ==================== CMS: ASSET TYPES ====================

model AssetType {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  color       String?  @default("#059669")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CMS: TRANSLATIONS ====================

model Translation {
  id          String   @id @default(cuid())
  key         String
  locale      String   @default("es")
  value       String   @default("")

  @@unique([key, locale])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== ANALYTICS: PAGE VISITS ====================

model PageVisit {
  id          String   @id @default(cuid())
  page        String
  path        String
  referrer    String?
  userAgent   String?
  country     String?
  sessionId   String?
  userId      String?

  createdAt   DateTime @default(now())

  @@index([page, createdAt])
  @@index([createdAt])
}

// ==================== CMS: CURRENCIES ====================

model Currency {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  symbol      String   @default("")
  flag        String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== REFERRAL SYSTEM ====================

model ReferralCode {
  id          String   @id @default(cuid())
  code        String   @unique
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  usesCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referrals   Referral[]
}

// ==================== AI INVESTMENT ANALYSIS ====================

model InvestmentAnalysis {
  id              String   @id @default(cuid())
  assetId         String
  assetName       String
  analysis        String
  investorCountry String?
  generatedAt     DateTime @default(now())

  createdAt       DateTime @default(now())
}

// ==================== SECONDARY MARKET ====================

model SecondaryMarketListing {
  id                  String    @id @default(cuid())
  sellerId            String
  seller              User        @relation("SellerListings", fields: [sellerId], references: [id])
  investmentId        String
  investment          Investment @relation(fields: [investmentId], references: [id])
  assetId             String
  asset               Asset       @relation(fields: [assetId], references: [id])

  fractionCount       Int
  pricePerFraction    Float
  totalPrice          Float
  status              String     @default("active")

  buyerId             String?
  buyer               User?       @relation("BuyerPurchases", fields: [buyerId], references: [id])
  soldFractionCount   Int        @default(0)
  platformFee         Float      @default(0)
  netAmount           Float?

  expiresAt           DateTime?
  soldAt              DateTime?
  cancelledAt         DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([sellerId])
  @@index([assetId])
  @@index([status])
}

model Referral {
  id              String        @id @default(cuid())
  referrerId      String
  referrer        User          @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referredId      String
  referred        User          @relation("ReferredReferrals", fields: [referredId], references: [id])
  referralCodeId  String?
  referralCode    ReferralCode? @relation(fields: [referralCodeId], references: [id])
  bonusAmount     Float         @default(0)
  bonusCurrency   String        @default("USD")
  status          String        @default("pending") // pending, completed, paid
  createdAt       DateTime      @default(now())

  @@index([referrerId])
  @@index([referredId])
  @@index([status])
}

// ==================== CMS: NEWSLETTER SUBSCRIPTIONS ====================

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String   @default("homepage")

  createdAt DateTime @default(now())
}

// ==================== CMS: DYNAMIC PAGES ====================

model CmsPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @default("")
  excerpt     String   @default("")
  category    String   @default("company") // company, legal, support
  icon        String   @default("FileText")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  seoTitle    String?
  seoDescription String?
  lastEditedBy String?
  lastEditedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
